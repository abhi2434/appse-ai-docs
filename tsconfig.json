{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // Required by TypeScript 5.x to anchor the inherited "@site/*" path mapping to this
    // directory. Do not remove while "typescript" is pinned to ~5.6.x — dropping it breaks
    // "@site/*" resolution, and "ignoreDeprecations": "6.0" is not a valid value in 5.6.
    "baseUrl": "."
  },
  "exclude": [".docusaurus", "build"]
}
